[Unit]
Description=Quantify 回调观察台每日更新（%i）
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=quantify
Group=quantify
WorkingDirectory=/opt/quantify/app
Environment=HOME=/opt/quantify
Environment=PATH=/opt/quantify/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/quantify/app/deploy/daily.sh %i
TimeoutStartSec=15min

# 这台机器上还跑着交易机器人，要让着它们。空余内存只有 300–500 MB，swappiness=0 所以交换空间基本用不上。
# 这个任务约 350 MB。CPU 和磁盘用最低优先级；万一整台机器内存不够，最先被结束的是它。
# 不设 MemoryHigh：超过它进程只会被拖慢、卡着不退出（2026-11-04 卡了 45 分钟）。超过 MemoryMax 就立刻结束，
# OOMPolicy=continue 让 daily.sh 活下来，发出失败提醒。
Nice=19
CPUWeight=20
IOSchedulingClass=idle
MemoryMax=500M
OOMPolicy=continue
OOMScoreAdjust=1000

# 只能写自己的目录和网页目录
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/quantify -/var/www/quantify
